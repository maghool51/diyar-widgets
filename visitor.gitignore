# ==========================================================================
# Diyar Visitor Widget — .gitignore
# ==========================================================================

# Dependencies
node_modules/
jspm_packages/

# Package manager artifacts
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnpm-store/

# Build & distribution output
dist/
build/
out/
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Environment & secrets
.env
.env.*
!.env.example

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Testing & coverage
coverage/
.nyc_output/

# OS files
desktop.ini

# Local override files
*.local
