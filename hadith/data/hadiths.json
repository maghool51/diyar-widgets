{
  "hadiths": [
    {
      "id": 1,
      "text": "همانا اعمال به نیت‌ها بستگی دارد و برای هر کس همان است که نیت کرده است.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "نیت",
      "tags": [
        "نیت",
        "عمل"
      ]
    },
    {
      "id": 2,
      "text": "هر کس به خدا و روز قیامت ایمان دارد، باید سخن نیک بگوید یا سکوت کند.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "اخلاق",
      "tags": [
        "زبان",
        "سکوت"
      ]
    },
    {
      "id": 3,
      "text": "هیچ‌یک از شما مؤمن نیست تا برای برادرش همان را دوست بدارد که برای خود دوست دارد.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری و مسلم",
      "category": "برادری",
      "tags": [
        "برادری",
        "ایمان"
      ]
    },
    {
      "id": 4,
      "text": "طلب علم بر هر مسلمانی واجب است.",
      "source": "پیامبر اکرم (ص)",
      "book": "ابن ماجه",
      "category": "علم",
      "tags": [
        "علم",
        "تحصیل"
      ]
    },
    {
      "id": 5,
      "text": "بهترین شما کسی است که قرآن بیاموزد و آن را تعلیم دهد.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "علم",
      "tags": [
        "قرآن",
        "تعلیم"
      ]
    },
    {
      "id": 6,
      "text": "مسلمان کسی است که مسلمانان از زبان و دستش در امان باشند.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "اخلاق",
      "tags": [
        "امنیت",
        "زبان"
      ]
    },
    {
      "id": 7,
      "text": "اسلام بر پنج پایه بنا شده است: شهادتین، نماز، زکات، حج و روزه‌ی ماه رمضان.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری و مسلم",
      "category": "عقیده",
      "tags": [
        "ارکان دین"
      ]
    },
    {
      "id": 8,
      "text": "مهربانان را خداوند رحمان مورد رحمت قرار می‌دهد؛ به اهل زمین رحم کنید تا آنکه در آسمان است به شما رحم کند.",
      "source": "پیامبر اکرم (ص)",
      "book": "ترمذی",
      "category": "اخلاق",
      "tags": [
        "رحمت",
        "مهربانی"
      ]
    },
    {
      "id": 9,
      "text": "هر کس سکوت کند، نجات می‌یابد.",
      "source": "پیامبر اکرم (ص)",
      "book": "ترمذی",
      "category": "اخلاق",
      "tags": [
        "سکوت"
      ]
    },
    {
      "id": 10,
      "text": "قوی کسی نیست که در کشتی بر دیگران غالب شود؛ قوی کسی است که هنگام خشم بر خویشتن مسلط باشد.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری و مسلم",
      "category": "اخلاق",
      "tags": [
        "خشم",
        "خویشتن‌داری"
      ]
    },
    {
      "id": 11,
      "text": "بهترین شما کسانی هستند که اخلاق‌شان نیکوتر است.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "اخلاق",
      "tags": [
        "اخلاق نیک"
      ]
    },
    {
      "id": 12,
      "text": "از دنیای شما سه چیز نزد من محبوب شد: عطر، زنان و روشنی چشمم در نماز قرار داده شد.",
      "source": "پیامبر اکرم (ص)",
      "book": "نسائی",
      "category": "عبادت",
      "tags": [
        "نماز"
      ]
    },
    {
      "id": 13,
      "text": "کسی که راهی را برای طلب علم بپیماید، خداوند راهی به‌سوی بهشت برای او آسان می‌کند.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "علم",
      "tags": [
        "علم",
        "بهشت"
      ]
    },
    {
      "id": 14,
      "text": "دنیا زندان مؤمن و بهشت کافر است.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "دنیا",
      "tags": [
        "دنیا و آخرت"
      ]
    },
    {
      "id": 15,
      "text": "بهترین صدقه آن است که از روی بی‌نیازی داده شود.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "انفاق",
      "tags": [
        "صدقه"
      ]
    },
    {
      "id": 16,
      "text": "دست دهنده از دست گیرنده بهتر است.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "انفاق",
      "tags": [
        "بخشش"
      ]
    },
    {
      "id": 17,
      "text": "هیچ‌کس از شما لقمه‌ای بهتر از آنچه با دسترنج خویش می‌خورد، نخورده است.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "کار و تلاش",
      "tags": [
        "کسب حلال"
      ]
    },
    {
      "id": 18,
      "text": "کسی که راه راست نمی‌رود دیگر شرمی از خدا ندارد و هرچه می‌خواهد انجام دهد.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "اخلاق",
      "tags": [
        "حیا"
      ]
    },
    {
      "id": 19,
      "text": "حیا شاخه‌ای از ایمان است.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری و مسلم",
      "category": "اخلاق",
      "tags": [
        "حیا",
        "ایمان"
      ]
    },
    {
      "id": 20,
      "text": "مؤمن قوی نزد خدا بهتر و محبوب‌تر از مؤمن ضعیف است، هرچند در هر دو خیر هست.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "ایمان",
      "tags": [
        "قدرت"
      ]
    },
    {
      "id": 21,
      "text": "خداوند زیباست و زیبایی را دوست دارد.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "اخلاق",
      "tags": [
        "زیبایی"
      ]
    },
    {
      "id": 22,
      "text": "هر کس در راه علم‌آموزی گام بردارد، خداوند راه بهشت را بر او آسان می‌گرداند.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "علم",
      "tags": [
        "علم"
      ]
    },
    {
      "id": 23,
      "text": "همسایه‌ات را دوست بدار همان‌گونه که برای خودت دوست داری.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "برادری",
      "tags": [
        "همسایه"
      ]
    },
    {
      "id": 24,
      "text": "از اخلاق نیکو، خوش‌رویی با برادر مسلمان است.",
      "source": "پیامبر اکرم (ص)",
      "book": "ترمذی",
      "category": "اخلاق",
      "tags": [
        "خوش‌رویی"
      ]
    },
    {
      "id": 25,
      "text": "بخشنده به خدا نزدیک، به مردم نزدیک و از آتش دور است؛ اما بخیل از خدا دور و به آتش نزدیک است.",
      "source": "پیامبر اکرم (ص)",
      "book": "ترمذی",
      "category": "انفاق",
      "tags": [
        "بخشندگی"
      ]
    },
    {
      "id": 26,
      "text": "برترین جهاد، سخن حق در برابر حاکم ستمگر است.",
      "source": "پیامبر اکرم (ص)",
      "book": "ابوداوود و ترمذی",
      "category": "عدالت",
      "tags": [
        "حق‌گویی"
      ]
    },
    {
      "id": 27,
      "text": "از نشانه‌های نیکوی اسلام فرد، رها کردن کاری است که به او مربوط نیست.",
      "source": "پیامبر اکرم (ص)",
      "book": "ترمذی",
      "category": "اخلاق",
      "tags": [
        "فضولی"
      ]
    },
    {
      "id": 28,
      "text": "هرکس مؤمنی را از سختی دنیا برهاند، خداوند او را از سختی‌های قیامت می‌رهاند.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "برادری",
      "tags": [
        "کمک به دیگران"
      ]
    },
    {
      "id": 29,
      "text": "مؤمنان در دوستی و مهربانی و رحمت نسبت به هم، مانند یک پیکرند؛ اگر عضوی به درد آید، سایر اعضا با تب و بی‌خوابی با آن همراهی می‌کنند.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری و مسلم",
      "category": "برادری",
      "tags": [
        "اتحاد"
      ]
    },
    {
      "id": 30,
      "text": "خداوند به صورت‌ها و اموال شما نمی‌نگرد، بلکه به دل‌ها و اعمال شما می‌نگرد.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "اخلاق",
      "tags": [
        "نیت"
      ]
    },
    {
      "id": 31,
      "text": "از نشانه‌های خوب بودن اسلام کسی، سخن‌گفتن کم درباره‌ی چیزی است که به او ربطی ندارد.",
      "source": "پیامبر اکرم (ص)",
      "book": "ترمذی",
      "category": "اخلاق",
      "tags": [
        "زبان"
      ]
    },
    {
      "id": 32,
      "text": "هرکس در روزی که بر او گذشت غم دنیا را نخورد و به فکر آخرتش باشد، خداوند بی‌نیازیش را در دلش قرار می‌دهد.",
      "source": "پیامبر اکرم (ص)",
      "book": "ترمذی",
      "category": "دنیا",
      "tags": [
        "قناعت"
      ]
    },
    {
      "id": 33,
      "text": "سه چیز است که هر کس آن را داشته باشد، شیرینی ایمان را می‌چشد: خدا و رسولش را از هر چیز دیگر بیشتر دوست داشتن.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "ایمان",
      "tags": [
        "محبت الهی"
      ]
    },
    {
      "id": 34,
      "text": "از بهترین اعمال، به‌جا آوردن نماز در وقت آن است.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری",
      "category": "عبادت",
      "tags": [
        "نماز"
      ]
    },
    {
      "id": 35,
      "text": "پاکیزگی نیمی از ایمان است.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "عبادت",
      "tags": [
        "پاکیزگی"
      ]
    },
    {
      "id": 36,
      "text": "هرکس گره‌ای از مشکلات یک مؤمن را بگشاید، خداوند در دنیا و آخرت گره از کارش می‌گشاید.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "برادری",
      "tags": [
        "گره‌گشایی"
      ]
    },
    {
      "id": 37,
      "text": "با مردم به‌گونه‌ای رفتار کن که دوست داری با تو رفتار کنند.",
      "source": "پیامبر اکرم (ص)",
      "book": "بیهقی",
      "category": "اخلاق",
      "tags": [
        "معاشرت"
      ]
    },
    {
      "id": 38,
      "text": "بهترین مردم کسی است که برای مردم سودمندتر باشد.",
      "source": "پیامبر اکرم (ص)",
      "book": "دارقطنی",
      "category": "اخلاق",
      "tags": [
        "سودمندی"
      ]
    },
    {
      "id": 39,
      "text": "هرکس امروز و فردا کند و بگوید فردا توبه می‌کنم، در حقیقت خود را فریب داده است.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "تقوا",
      "tags": [
        "توبه"
      ]
    },
    {
      "id": 40,
      "text": "از جمله‌ی بلاهای بزرگ، همنشینی با اهل شرارت است.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "دوستی",
      "tags": [
        "همنشینی"
      ]
    },
    {
      "id": 41,
      "text": "دل‌ها همچون بدن‌ها خسته می‌شوند، پس با سخنان حکیمانه طراوتشان را برگردانید.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "حکمت",
      "tags": [
        "دل"
      ]
    },
    {
      "id": 42,
      "text": "مردم دشمن آنند که نمی‌دانند.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "علم",
      "tags": [
        "جهل"
      ]
    },
    {
      "id": 43,
      "text": "ارزش هر انسان به اندازه‌ی چیزی است که نیکو انجام می‌دهد.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "حکمت",
      "tags": [
        "ارزش انسان"
      ]
    },
    {
      "id": 44,
      "text": "بخشنده‌ترین مردم کسی است که در نیازمندی خود نیز بخشش کند.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "انفاق",
      "tags": [
        "بخشندگی"
      ]
    },
    {
      "id": 45,
      "text": "بهترین دوست کسی است که عیب تو را به تو بگوید.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "دوستی",
      "tags": [
        "نصیحت"
      ]
    },
    {
      "id": 46,
      "text": "هیچ ثروتی سودمندتر از عقل نیست و هیچ فقری بدتر از نادانی نیست.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "عقل",
      "tags": [
        "عقل"
      ]
    },
    {
      "id": 47,
      "text": "با مردم چنان مدارا کن که اگر مردی، بر تو گریه کنند و اگر زنده ماندی، مشتاق تو باشند.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "اخلاق",
      "tags": [
        "مدارا"
      ]
    },
    {
      "id": 48,
      "text": "زبان انسان از پشت پرده‌ی دهانش، عقل او را نشان می‌دهد.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "زبان",
      "tags": [
        "عقل"
      ]
    },
    {
      "id": 49,
      "text": "صبر بر دو گونه است: صبر بر آنچه ناخوش‌آیند توست و صبر از آنچه دوست می‌داری.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "صبر",
      "tags": [
        "صبر"
      ]
    },
    {
      "id": 50,
      "text": "هرکس از خود بازخواست کند، سودش برد؛ و هرکس از خود غافل شود، زیان کرد.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "تقوا",
      "tags": [
        "خودسازی"
      ]
    },
    {
      "id": 51,
      "text": "چه بسا کسانی که با نعمت‌ها آزمایش می‌شوند و چه بسا کسانی که با بلا مورد لطف قرار می‌گیرند.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "صبر",
      "tags": [
        "آزمایش الهی"
      ]
    },
    {
      "id": 52,
      "text": "از دست دادن دوستان، غربت است.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "دوستی",
      "tags": [
        "غربت"
      ]
    },
    {
      "id": 53,
      "text": "کسی که طمع بورزد، خود را خوار می‌کند.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "اخلاق",
      "tags": [
        "طمع"
      ]
    },
    {
      "id": 54,
      "text": "قناعت، ثروتی است که پایان نمی‌پذیرد.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "قناعت",
      "tags": [
        "قناعت"
      ]
    },
    {
      "id": 55,
      "text": "بخشش، زکات پیروزی‌هاست.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "انفاق",
      "tags": [
        "بخشندگی"
      ]
    },
    {
      "id": 56,
      "text": "در آزمایش‌ها، اصالت مردان آشکار می‌شود.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "صبر",
      "tags": [
        "آزمون"
      ]
    },
    {
      "id": 57,
      "text": "هرکس تلاش کند، به مقصود برسد یا نزدیک آن شود.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "کار و تلاش",
      "tags": [
        "تلاش"
      ]
    },
    {
      "id": 58,
      "text": "با کسی که ادب ندارد همنشین مشو، مبادا اخلاقش به تو سرایت کند.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "دوستی",
      "tags": [
        "همنشینی"
      ]
    },
    {
      "id": 59,
      "text": "عقل، راهنمای مؤمن است.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "عقل",
      "tags": [
        "عقل"
      ]
    },
    {
      "id": 60,
      "text": "هیچ عبادتی مانند تفکر نیست.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "عبادت",
      "tags": [
        "تفکر"
      ]
    },
    {
      "id": 61,
      "text": "کسی که سخن اندک بگوید، خطایش نیز اندک می‌شود.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "زبان",
      "tags": [
        "سکوت"
      ]
    },
    {
      "id": 62,
      "text": "بهترین سرمایه، خرد است.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "عقل",
      "tags": [
        "خرد"
      ]
    },
    {
      "id": 63,
      "text": "دلیل بر کمال عقل، خوش‌رفتاری با مردم است.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "اخلاق",
      "tags": [
        "خوش‌رفتاری"
      ]
    },
    {
      "id": 64,
      "text": "هرکس بر کار خود بیندیشد پیش از انجام آن، از لغزش در امان می‌ماند.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "حکمت",
      "tags": [
        "تدبیر"
      ]
    },
    {
      "id": 65,
      "text": "فروتنی، ریشه‌ی هر بزرگی است.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "اخلاق",
      "tags": [
        "تواضع"
      ]
    },
    {
      "id": 66,
      "text": "از نشانه‌های خرد، شکیبایی در برابر نادان است.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "صبر",
      "tags": [
        "بردباری"
      ]
    },
    {
      "id": 67,
      "text": "عمر انسان، سرمایه‌ی اوست؛ آن را در راه بیهوده تباه مکن.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "وقت",
      "tags": [
        "وقت"
      ]
    },
    {
      "id": 68,
      "text": "هرکس با خدا معامله کند، سودی نکند مگر افزونی.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "توکل",
      "tags": [
        "توکل"
      ]
    },
    {
      "id": 69,
      "text": "عدالت، زندگی احکام است.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "عدالت",
      "tags": [
        "عدالت"
      ]
    },
    {
      "id": 70,
      "text": "با عدالت، حکومت‌ها استوار می‌مانند.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "عدالت",
      "tags": [
        "حکومت"
      ]
    },
    {
      "id": 71,
      "text": "برترین عبادت، اندیشیدن درباره‌ی خدا و قدرت اوست.",
      "source": "امام صادق (ع)",
      "book": "الکافی",
      "category": "عبادت",
      "tags": [
        "تفکر"
      ]
    },
    {
      "id": 72,
      "text": "هیچ عملی بدون نیت پاک ارزشی ندارد.",
      "source": "امام صادق (ع)",
      "book": "الکافی",
      "category": "نیت",
      "tags": [
        "نیت"
      ]
    },
    {
      "id": 73,
      "text": "مؤمن باید سه ویژگی داشته باشد: در عبادت خدا کوشا باشد، در برابر بلا شکیبا باشد و در روزی روزانه‌اش قانع باشد.",
      "source": "امام صادق (ع)",
      "book": "الکافی",
      "category": "ایمان",
      "tags": [
        "صفات مؤمن"
      ]
    },
    {
      "id": 74,
      "text": "از نشانه‌های یقین آن است که مردم را با کارهای خدا خشمگین نکنی.",
      "source": "امام صادق (ع)",
      "book": "الکافی",
      "category": "ایمان",
      "tags": [
        "یقین"
      ]
    },
    {
      "id": 75,
      "text": "صله‌ی رحم، عمر را طولانی می‌کند.",
      "source": "امام صادق (ع)",
      "book": "الکافی",
      "category": "خانواده",
      "tags": [
        "صله رحم"
      ]
    },
    {
      "id": 76,
      "text": "بهترین شما کسی است که برای خانواده‌اش بهترین باشد.",
      "source": "پیامبر اکرم (ص)",
      "book": "ابن ماجه",
      "category": "خانواده",
      "tags": [
        "خانواده"
      ]
    },
    {
      "id": 77,
      "text": "بهشت زیر پای مادران است.",
      "source": "پیامبر اکرم (ص)",
      "book": "نسائی",
      "category": "خانواده",
      "tags": [
        "مادر"
      ]
    },
    {
      "id": 78,
      "text": "هیچ پدری هدیه‌ای بهتر از ادب نیکو به فرزندش نمی‌دهد.",
      "source": "پیامبر اکرم (ص)",
      "book": "ترمذی",
      "category": "خانواده",
      "tags": [
        "تربیت فرزند"
      ]
    },
    {
      "id": 79,
      "text": "کامل‌ترین مؤمنان در ایمان، خوش‌اخلاق‌ترین آن‌هاست و بهترین شما کسی است که با خانواده‌اش بهتر باشد.",
      "source": "پیامبر اکرم (ص)",
      "book": "ترمذی",
      "category": "خانواده",
      "tags": [
        "اخلاق در خانواده"
      ]
    },
    {
      "id": 80,
      "text": "با زنان به نیکی رفتار کنید.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح بخاری و مسلم",
      "category": "خانواده",
      "tags": [
        "همسر"
      ]
    },
    {
      "id": 81,
      "text": "خیرخواه‌ترین مردم نسبت به من، کسی است که در نبود من نیز خیرخواه خانواده و مالم باشد.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "خانواده",
      "tags": [
        "امانت‌داری"
      ]
    },
    {
      "id": 82,
      "text": "دنیا متاعی است و بهترین متاع دنیا همسر شایسته است.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "خانواده",
      "tags": [
        "همسر شایسته"
      ]
    },
    {
      "id": 83,
      "text": "صدقه دادن پنهانی، خشم پروردگار را فرو می‌نشاند.",
      "source": "پیامبر اکرم (ص)",
      "book": "طبرانی",
      "category": "انفاق",
      "tags": [
        "صدقه پنهانی"
      ]
    },
    {
      "id": 84,
      "text": "از هر معروفی، حتی دیدار با چهره‌ی گشاده با برادرت غافل مشو.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "اخلاق",
      "tags": [
        "گشاده‌رویی"
      ]
    },
    {
      "id": 85,
      "text": "کسی که به کار خیر راهنمایی کند، مانند انجام‌دهنده‌ی آن پاداش می‌برد.",
      "source": "پیامبر اکرم (ص)",
      "book": "صحیح مسلم",
      "category": "انفاق",
      "tags": [
        "راهنمایی به خیر"
      ]
    },
    {
      "id": 86,
      "text": "از مؤمن پرهیز کن که دشمنی‌اش را نادیده بگیری، شاید روزی دوست تو شود.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "دوستی",
      "tags": [
        "دشمنی"
      ]
    },
    {
      "id": 87,
      "text": "در برابر ستمگر، سخن حق بگو، هرچند تلخ باشد.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "عدالت",
      "tags": [
        "حق‌گویی"
      ]
    },
    {
      "id": 88,
      "text": "هرکه دنیا را بشناسد، به مصیبت‌های آن اندوهگین نمی‌شود.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "دنیا",
      "tags": [
        "شناخت دنیا"
      ]
    },
    {
      "id": 89,
      "text": "دانش، میراثی گران‌بهاست و ادب، زینتی همیشگی.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "علم",
      "tags": [
        "دانش و ادب"
      ]
    },
    {
      "id": 90,
      "text": "هرکس از لغزش‌های خود آگاه باشد، لغزش دیگران را نادیده می‌گیرد.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "اخلاق",
      "tags": [
        "خودشناسی"
      ]
    },
    {
      "id": 91,
      "text": "بهترین وسیله‌ی رسیدن به خدا، ایمان به او و جهاد در راه اوست.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "ایمان",
      "tags": [
        "ایمان"
      ]
    },
    {
      "id": 92,
      "text": "صبر کلید گشایش است.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "صبر",
      "tags": [
        "گشایش"
      ]
    },
    {
      "id": 93,
      "text": "هرکس تقوا پیشه کند، راه بیرون‌رفت از مشکلات برایش گشوده می‌شود.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "تقوا",
      "tags": [
        "تقوا"
      ]
    },
    {
      "id": 94,
      "text": "کسی که به‌اندازه‌ی کفایت قانع باشد، آسوده می‌گذراند.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "قناعت",
      "tags": [
        "قناعت"
      ]
    },
    {
      "id": 95,
      "text": "از دنیا آنچه را که تو را به آخرت می‌رساند، برگیر.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "دنیا",
      "tags": [
        "دنیا و آخرت"
      ]
    },
    {
      "id": 96,
      "text": "راستگویی، زبان امانت‌دار قلب است.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "اخلاق",
      "tags": [
        "راستگویی"
      ]
    },
    {
      "id": 97,
      "text": "بهترین اعمال نزد خدا، خشنودتر کردن دل مؤمن است.",
      "source": "پیامبر اکرم (ص)",
      "book": "طبرانی",
      "category": "برادری",
      "tags": [
        "خشنودی مؤمن"
      ]
    },
    {
      "id": 98,
      "text": "کسی که راه علم را در پیش گیرد و صبر پیشه کند، به مقصود می‌رسد.",
      "source": "امام علی (ع)",
      "book": "غررالحکم",
      "category": "علم",
      "tags": [
        "علم و صبر"
      ]
    },
    {
      "id": 99,
      "text": "هیچ کاری نزد خدا محبوب‌تر از انتظار گشایش نیست.",
      "source": "پیامبر اکرم (ص)",
      "book": "ترمذی",
      "category": "توکل",
      "tags": [
        "امید به خدا"
      ]
    },
    {
      "id": 100,
      "text": "هرکس در راه خدا گامی بردارد، خداوند گام‌هایش را استوار می‌گرداند.",
      "source": "امام علی (ع)",
      "book": "نهج البلاغه",
      "category": "توکل",
      "tags": [
        "استقامت"
      ]
    }
  ]
}